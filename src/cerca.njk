---
layout: base.njk
title: Cerca
permalink: /cerca/
---
<h1>Cerca una ricetta</h1>

<input
  type="search"
  id="campo-ricerca"
  class="campo-ricerca"
  placeholder="Cerca per nome, ingrediente, tag..."
  autocomplete="off"
>

<ul id="risultati-ricerca" class="elenco-ricette"></ul>

<script>
  (function () {
    const campo = document.getElementById("campo-ricerca");
    const risultati = document.getElementById("risultati-ricerca");
    let ricette = [];

    fetch("{{ '/ricette-indice.json' | url }}")
      .then((res) => res.json())
      .then((dati) => {
        ricette = dati;
        disegna(ricette);
      });

    function disegna(lista) {
      risultati.innerHTML = "";
      lista.forEach((ricetta) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = ricetta.url;

        if (ricetta.immagine) {
          const thumb = document.createElement("img");
          thumb.className = "elenco-ricette-thumb";
          thumb.src = ricetta.immagine;
          thumb.alt = "";
          a.appendChild(thumb);
        } else {
          const thumb = document.createElement("span");
          thumb.className = "elenco-ricette-thumb";
          a.appendChild(thumb);
        }
        a.appendChild(document.createTextNode(ricetta.titolo));
        li.appendChild(a);

        (ricetta.tipo_piatto || []).forEach((tipo) => {
          const badge = document.createElement("span");
          badge.className = "badge";
          badge.textContent = tipo;
          li.appendChild(badge);
        });

        risultati.appendChild(li);
      });
    }

    campo.addEventListener("input", () => {
      const query = campo.value.trim().toLowerCase();
      if (!query) {
        disegna(ricette);
        return;
      }
      const filtrate = ricette.filter((r) =>
        r.testoRicerca.includes(query)
      );
      disegna(filtrate);
    });
  })();
</script>
