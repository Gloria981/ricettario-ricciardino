---
layout: base.njk
title: Ricette
---
<h1>Tutte le ricette</h1>

{% if collections.ricette.length == 0 %}
  <p>Nessuna ricetta ancora. Aggiungine una nella cartella <code>src/ricette/</code>.</p>
{% else %}
  <ul class="elenco-ricette">
    {% for ricetta in collections.ricette %}
      <li>
        <a href="{{ ricetta.url | url }}">
          {% if ricetta.data.immagine %}
            <img class="elenco-ricette-thumb" src="{{ ricetta.data.immagine | url }}" alt="">
          {% else %}
            <span class="elenco-ricette-thumb" aria-hidden="true"></span>
          {% endif %}
          {{ ricetta.data.titolo }}
        </a>
        {% for tipo in ricetta.data.tipo_piatto %}
          <span class="badge">{{ tipo }}</span>
        {% endfor %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
